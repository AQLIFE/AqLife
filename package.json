{
  "name": "aqlife-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AqLife 工业级个人博客 Monorepo 仓储",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "bootstrap": "npm run bootstrap --workspace=@aqlife/scripts",
    "ci": "npm run check --workspace=@aqlife/ci",
    "ci:frontend": "npm run check:frontend --workspace=@aqlife/ci",
    "ci:api": "npm run check:api --workspace=@aqlife/ci",
    "generate:contract": "npm run generate:contract --workspace=@aqlife/scripts",
    "dev:api": "npm run dev:api --workspace=@aqlife/scripts",
    "dev:web": "npm run dev:web --workspace=@aqlife/scripts",
    "dev:mgs": "npm run dev:mgs --workspace=@aqlife/scripts"
  },
  "devDependencies": {
    "@iconify/utils": "^3.1.3",
    "@tsconfig/node24": "^24.0.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
