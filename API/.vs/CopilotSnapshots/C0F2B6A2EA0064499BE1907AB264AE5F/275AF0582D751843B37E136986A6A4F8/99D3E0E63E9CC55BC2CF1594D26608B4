using MyLife.Core.Define;

namespace MyLife.Core.API
{
    public enum StorageUnit
    {
        NoLimit = 0,
        Byte = 1,
        KB = 2,
        MB = 3,
        GB = 4
    }
    public class FileSecurityPolicy(string defaultSavePath, int maxFileSize, StorageUnit unit, string[] fileTypes, bool allowUpload, bool allowDownload, bool allowDelete) : IFilePolicy
    {
        public string[] AllowedExtensions { init; get; } = fileTypes ?? throw new Exception("FileTypes cannot be null");
        public string StoragePath { init; get; } = defaultSavePath ?? throw new Exception("DefaultSavePath cannot be null");
        public bool AllowUpload { init; get; } = allowUpload;
        public bool AllowDownload { init; get; } = allowDownload;
        public bool AllowDelete { init; get; } = allowDelete;
        public StorageUnit Unit { init; get; } = unit;
        public int MaxFileSize { init; get; } = maxFileSize * ((int)Math.Ceiling(Math.Pow(1024, (int)unit)));
    }
    public class FilePolicyOptions : IFilePolicy
    {
        public int MaxFileSize { get; init; }
        public string[] AllowedExtensions { get; init; } = [];
        public string StoragePath { get; init; } = string.Empty;
        public StorageUnit Unit { get; init; }
        public bool AllowUpload { get; init; }
        public bool AllowDownload { get; init; }
        public bool AllowDelete { get; init; }
    }

}