using MyLife.Core.API;

var builder = WebApplication.CreateBuilder(args);

// Add services to the container.

builder.Services.AddControllers();
// Learn more about configuring OpenAPI at https://aka.ms/aspnet/openapi
builder.Services.AddOpenApi();
if (builder.Environment.IsDevelopment())
{
    string StorageConfig = $"Core\\Config\\FilePolicy.{builder.Environment.EnvironmentName}.json";
    if (File.Exists(StorageConfig))
    {
        builder.Configuration.AddJsonFile(StorageConfig, optional: true, reloadOnChange: true);
        // Register options from the loaded JSON and demonstrate reading values
        builder.Services.Configure<FilePolicyOptions>(builder.Configuration);
        Console.WriteLine(
            $"Loaded config from {StorageConfig}: StoragePath={builder.Configuration.GetValue<string>("StoragePath")}, MaxFileSize={builder.Configuration.GetValue<int>("MaxFileSize")}");
    }
    else throw new Exception("无法读取配置文件");
}

//builder.Services.AddScoped<IFilePolicyProvider, FilePolicyProvider>();

var app = builder.Build();

// Configure the HTTP request pipeline.
if (app.Environment.IsDevelopment())
{
    app.MapOpenApi();
    //Console.WriteLine(app.Configuration.GetValue<FileSecurityPolicy>("StoragePath"));
}


app.UseAuthorization();

app.MapControllers();

app.Run();
