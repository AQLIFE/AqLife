using MyLife.Core.API;
using MyLife.Core.Define;

public class FilePolicyProvider : IFilePolicyProvider
{
    private readonly IFilePolicyOptions _config;

    public FilePolicyProvider(IFilePolicyOptions config)
    {
        _config = config;
    }

    public FileSecurityPolicy GetPolicy()
    {
        // return domain type constructed from the configured IFilePolicy
        return new FileSecurityPolicy(_config.StoragePath, (int)_config.MaxFileSize, _config.Unit, _config.AllowedExtensions, _config.AllowUpload, _config.AllowDownload, _config.AllowDelete);
    }
}
