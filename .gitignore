# =============================================================================
# AqLife Monorepo — 单一 .gitignore（全仓库生效）
# =============================================================================

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.sw?
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.rsuser

# --- .NET / API ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
*.DotSettings.user

# --- Node / Monorepo (apps/*, packages/*, tools/*) ---
node_modules/
dist/
dist-ssr/
coverage/
*.local

.npm/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Vue tooling
**/.vite/
**/.cache/
**/node_modules/.tmp/

# OpenAPI Generator 本地缓存
.openapitools/

# --- 测试 / E2E ---
/cypress/videos/
/cypress/screenshots/
/playwright-report/
/test-results/

# --- 日志与运行时输出 ---
logs/
**/logs/
*.log
debug.log

API/Web/logs/
API/Web/Cache/

# --- 密钥与环境配置（切勿提交）---
# ASP.NET 使用 appsettings.json 及环境覆盖文件
API/Web/Configurations/appsettings.json
API/Web/Configurations/appsettings.*.json
!API/Web/Configurations/appsettings.*.example.json

**/secrets.json
.env
.env.*
!.env.example
!.env.*.example

# --- 本地工具 / 个人草稿（不入库）---
/APIFOX/
run/
API/API.mermaid
项目结构.md
