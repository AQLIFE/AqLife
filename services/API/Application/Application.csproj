<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AqLife.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Abstractions\**" />
    <Compile Remove="Core\**" />
    <Compile Remove="Modules\**" />
    <EmbeddedResource Remove="Abstractions\**" />
    <EmbeddedResource Remove="Core\**" />
    <EmbeddedResource Remove="Modules\**" />
    <None Remove="Abstractions\**" />
    <None Remove="Core\**" />
    <None Remove="Modules\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Modules\Account\Account.csproj" />
    <ProjectReference Include="Modules\Category\Category.csproj" />
    <ProjectReference Include="Modules\Corpus\Corpus.csproj" />
    <ProjectReference Include="Modules\Favorite\Favorite.csproj" />
    <ProjectReference Include="Modules\File\File.csproj" />
    <ProjectReference Include="Modules\Plan\Plan.csproj" />
    <ProjectReference Include="Modules\Tag\Tag.csproj" />
  </ItemGroup>

</Project>