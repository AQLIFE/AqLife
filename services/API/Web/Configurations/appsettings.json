{
  "DbOption": {
    "DbType": "PostgreSQL",
    "DbVersion": "18",
    "MigrationAssembly": "PostgreSqlMigrations"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal"
      }
    }
  }
}
