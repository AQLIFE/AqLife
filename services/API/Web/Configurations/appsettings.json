{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_LONG_RANDOM_SECRET",
    "Issuer": "WebAppIssuer",
