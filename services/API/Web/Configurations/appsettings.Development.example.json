{
  "Serilog": {
		"MinimumLevel": {
			"Default": "Information"
		}
	},
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_LONG_RANDOM_SECRET",
    "Issuer": "WebAppIssuer",
    "Audience": "WebAppAudience"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=YOUR_DB_IP; Database=YOUR_DB; Username=YOUR_DB_NAME; Password=YOUR_DB_PASSWORD;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5200",
      "http://192.168.0.100:5173",
      "http://192.168.0.100:5200"
    ]
  },
  "DbOption": {
    "DbType": "PostgreSQL",
    "DbVersion": "18",
    "MigrationAssembly": "PostgreSqlMigrations"
  }
}
