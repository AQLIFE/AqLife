{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_LONG_RANDOM_SECRET",
    "Issuer": "WebAppIssuer",
    "Audience": "WebAppAudience"
  },
  "HealthCheckSettings": {
    "RunHeavyChecks": true,
    "TimeoutSeconds": 5
  },
  "ConnectionStrings": {
    "MYSQL": "server=127.0.0.1;port=3306;user=YOUR_USER;password=YOUR_PASSWORD;database=AqLife;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5110",
      "http://localhost:5200",
      "http://192.168.0.100:5173",
      "http://192.168.0.100:5200"
    ]
  },
  "DbOption": {
    "DbType": "MYSQL",
    "DbVersion": "8.0.45"
  }
}
