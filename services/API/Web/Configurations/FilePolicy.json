{
  "FilePolicy": {
    "MaxFileSize": 100,
    "StoragePath": "Cache",
    "StorageUnit": 1,

    "AllowedUpload": [
      ".jpeg",
      ".jpg",
      ".png",
      ".svg",
      ".md"
    ],
    "AllowedDownload": [
      ".md"
    ],
    "AllowedImageExtensions": [
      ".jpeg",
      ".jpg",
      ".png",
      ".svg"
    ],
    "AllowedBlogExtensions": [
      "md"
    ]
  }
}