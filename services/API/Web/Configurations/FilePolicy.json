{
  "FilePolicy": {
    "MaxFileSize": 100,
    "VideoMaxFileSize": 1048576,
    "StoragePath": "Cache",
    "StorageUnit": 10,

    "AllowedUpload": [
      ".jpeg",
      ".jpg",
      ".png",
      ".svg",
      ".md",
      ".mp4",
      ".webm"
    ],
    "AllowedDownload": [
      ".md",
      ".mp4",
      ".webm"
    ],
    "AllowedImageExtensions": [
      ".jpeg",
      ".jpg",
      ".png",
      ".svg"
    ],
    "AllowedBlogExtensions": [
      ".md"
    ],
    "AllowedVideoExtensions": [
      ".mp4",
      ".webm"
    ]
  }
}